"""
EDA Assignment Solution
========================
This script solves the EDA questions from the supplied assignment.

Expected input datasets:
1. Bike Details Dataset      -> bike.csv
2. Car Sales Dataset         -> car_sales.csv
3. Amazon Sales Data         -> amazon.csv
4. Spotify Hip-hop Dataset   -> spotify.csv

Place the CSV files in the same folder as this script, or change the paths below.

Required packages:
    pip install pandas numpy matplotlib seaborn
"""

from pathlib import Path
import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

warnings.filterwarnings("ignore")
sns.set_theme(style="whitegrid")

BASE = Path(__file__).resolve().parent
BIKE_FILE = BASE / "bike.csv"
CAR_FILE = BASE / "car_sales.csv"
AMAZON_FILE = BASE / "amazon.csv"
SPOTIFY_FILE = BASE / "spotify.csv"

OUTPUT = BASE / "eda_outputs"
OUTPUT.mkdir(exist_ok=True)


def save_show(name):
    """Save current matplotlib figure and close it."""
    plt.tight_layout()
    plt.savefig(OUTPUT / name, dpi=150, bbox_inches="tight")
    plt.show()
    plt.close()


def find_col(df, candidates):
    """Return the first matching column, case-insensitively."""
    lookup = {str(c).strip().lower(): c for c in df.columns}
    for candidate in candidates:
        if candidate.lower() in lookup:
            return lookup[candidate.lower()]
    return None


def numeric_clean(s):
    return pd.to_numeric(
        s.astype(str).str.replace(r"[₹,$,%]", "", regex=True)
        .str.replace(",", "", regex=False)
        .str.strip(),
        errors="coerce",
    )


# ============================================================
# EDA - 1 : BIKE DATASET
# ============================================================

def bike_eda():
    print("\n" + "=" * 70)
    print("EDA - 1 : BIKE DETAILS DATASET")
    print("=" * 70)

    df = pd.read_csv(BIKE_FILE)
    df.columns = [str(c).strip() for c in df.columns]

    price = find_col(df, ["selling_price"])
    year = find_col(df, ["year"])
    seller = find_col(df, ["seller_type"])
    owner = find_col(df, ["owner"])
    km = find_col(df, ["km_driven"])
    showroom = find_col(df, ["ex_showroom_price"])
    name = find_col(df, ["name"])

    for c in [price, year, km, showroom]:
        if c:
            df[c] = numeric_clean(df[c])

    print("\nShape:", df.shape)
    print("\nMissing values:")
    print(df.isna().sum())

    # 1. Range of selling prices
    print("\n1. Selling price range:")
    print("Minimum:", df[price].min())
    print("Maximum:", df[price].max())
    print("Range:", df[price].max() - df[price].min())

    # 2. Median selling price
    print("\n2. Median selling price:", df[price].median())

    # 3. Most common seller type
    print("\n3. Most common seller type:")
    print(df[seller].mode().iloc[0])

    # 4. Bikes > 50,000 km
    print("\n4. Bikes driven > 50,000 km:", (df[km] > 50000).sum())

    # 5. Average km by ownership type
    print("\n5. Average km driven by ownership type:")
    print(df.groupby(owner)[km].mean().sort_values(ascending=False))

    # 6. Proportion from 2015 or older
    proportion = (df[year] <= 2015).mean()
    print("\n6. Proportion from 2015 or older:", proportion)
    print("Percentage:", proportion * 100, "%")

    # 7. Missing-value trend
    print("\n7. Missing values:")
    print(df.isna().sum())
    df.isna().sum().plot(kind="bar", title="Missing Values by Column")
    save_show("bike_missing_values.png")

    # 8. Highest ex-showroom price and bike
    idx = df[showroom].idxmax()
    print("\n8. Highest ex-showroom price:")
    print("Price:", df.loc[idx, showroom])
    print("Bike:", df.loc[idx, name])

    # 9. Bikes by seller type
    print("\n9. Number of bikes by seller type:")
    print(df[seller].value_counts())

    # 10. Selling price vs km driven for first owners
    first = df[df[owner].astype(str).str.contains("1st", case=False, na=False)]
    print("\n10. First-owner correlation (selling price vs km driven):",
          first[[price, km]].corr().iloc[0, 1])
    sns.scatterplot(data=first, x=km, y=price)
    plt.title("Selling Price vs KM Driven - First Owner")
    save_show("bike_first_owner_price_vs_km.png")

    # 11. IQR outlier removal
    q1 = df[km].quantile(0.25)
    q3 = df[km].quantile(0.75)
    iqr = q3 - q1
    lower = q1 - 1.5 * iqr
    upper = q3 + 1.5 * iqr
    outliers = df[(df[km] < lower) | (df[km] > upper)]
    clean = df[(df[km] >= lower) & (df[km] <= upper)].copy()

    print("\n11. KM outlier limits:", lower, upper)
    print("Outliers removed:", len(outliers))
    print("Rows after removal:", len(clean))

    # 12. Year vs selling price
    sns.scatterplot(data=df, x=year, y=price)
    plt.title("Year vs Selling Price")
    save_show("bike_year_vs_selling_price.png")

    # 13. Average depreciation by bike age
    current_year = pd.Timestamp.today().year
    df["age"] = current_year - df[year]
    depreciation = df.groupby("age")[price].mean().sort_index()
    print("\n13. Average selling price by bike age:")
    print(depreciation)
    sns.lineplot(x=depreciation.index, y=depreciation.values, marker="o")
    plt.title("Average Selling Price by Bike Age")
    plt.xlabel("Age (years)")
    plt.ylabel("Average Selling Price")
    save_show("bike_depreciation_by_age.png")

    # 14. Bikes significantly above yearly average
    yearly_avg = df.groupby(year)[price].transform("mean")
    above = df[df[price] > yearly_avg * 1.20].sort_values(price, ascending=False)
    print("\n14. Bikes priced >20% above their manufacturing-year average:")
    print(above[[name, year, price]].head(20).to_string(index=False))

    # 15. Correlation matrix
    numeric = df.select_dtypes(include=np.number)
    print("\n15. Correlation matrix:")
    print(numeric.corr())
    plt.figure(figsize=(9, 6))
    sns.heatmap(numeric.corr(), annot=True, cmap="coolwarm", fmt=".2f")
    plt.title("Bike Dataset Correlation Matrix")
    save_show("bike_correlation_heatmap.png")

    return df


