# EDA - 2 : CAR SALES DATASET
# ============================================================

def car_eda():
    print("\n" + "=" * 70)
    print("EDA - 2 : CAR SALES DATASET")
    print("=" * 70)

    df = pd.read_csv(CAR_FILE)
    df.columns = [str(c).strip() for c in df.columns]

    price = find_col(df, ["Price ($)", "Price"])
    company = find_col(df, ["Company"])
    dealer = find_col(df, ["Dealer_Name"])
    transmission = find_col(df, ["Transmission"])
    region = find_col(df, ["Dealer_Region"])
    body = find_col(df, ["Body Style"])
    gender = find_col(df, ["Gender"])
    income = find_col(df, ["Annual Income"])
    engine = find_col(df, ["Engine"])
    model = find_col(df, ["Model"])
    color = find_col(df, ["Color"])
    date = find_col(df, ["Date"])

    df[price] = numeric_clean(df[price])
    df[income] = numeric_clean(df[income])
    df["sale_date"] = pd.to_datetime(df[date], errors="coerce")

    print("\nShape:", df.shape)

    # 1. Average price for each dealer
    print("\n1. Average selling price by dealer:")
    print(df.groupby(dealer)[price].mean().sort_values(ascending=False).head(20))

    # 2. Company with highest price variation
    variation = df.groupby(company)[price].agg(["std", "var", "mean"])
    print("\n2. Company with highest price standard deviation:")
    print(variation["std"].idxmax())
    print(variation.loc[variation["std"].idxmax()])

    # 3. Price distribution by transmission
    sns.boxplot(data=df, x=transmission, y=price)
    plt.title("Car Price Distribution by Transmission")
    save_show("car_price_by_transmission.png")
    print("\n3. IQR by transmission:")
    print(df.groupby(transmission)[price].quantile([.25, .75]).unstack())

    # 4. Price distribution across regions
    sns.boxplot(data=df, x=region, y=price)
    plt.xticks(rotation=45)
    plt.title("Car Prices Across Regions")
    save_show("car_price_by_region.png")

    # 5. Body-style distribution
    print("\n5. Body style counts:")
    print(df[body].value_counts())
    sns.countplot(data=df, x=body, order=df[body].value_counts().index)
    plt.xticks(rotation=45)
    plt.title("Cars by Body Style")
    save_show("car_body_style_distribution.png")

    # 6. Average price by gender and income
    print("\n6. Average price by customer gender:")
    print(df.groupby(gender)[price].mean())
    income_bins = pd.qcut(df[income], q=4, duplicates="drop")
    print("\nAverage price by income quartile:")
    print(df.groupby(income_bins, observed=False)[price].mean())

    # 7. Price + count by region
    region_summary = df.groupby(region).agg(
        average_price=(price, "mean"),
        cars_sold=(price, "size")
    ).sort_values("average_price", ascending=False)
    print("\n7. Region summary:")
    print(region_summary)

    # 8. Average price by engine
    print("\n8. Average price by engine:")
    print(df.groupby(engine)[price].mean().sort_values(ascending=False))
    sns.boxplot(data=df, x=engine, y=price)
    plt.xticks(rotation=45)
    plt.title("Price Distribution by Engine")
    save_show("car_price_by_engine.png")

    # 9. Income bracket
    df["income_bracket"] = pd.qcut(df[income], q=4, duplicates="drop")
    print("\n9. Price by income bracket:")
    print(df.groupby("income_bracket", observed=False)[price].agg(["mean", "median", "count"]))

    # 10. Top 5 models by sales
    top5_models = df[model].value_counts().head(5)
    print("\n10. Top 5 models by sales:")
    print(top5_models)
    top_models_df = df[df[model].isin(top5_models.index)]
    sns.boxplot(data=top_models_df, x=model, y=price)
    plt.xticks(rotation=45)
    plt.title("Price Distribution - Top 5 Models")
    save_show("car_top5_models_price.png")

    # 11. Engine size vs price across colors
    engine_numeric = df[engine].astype(str).str.extract(r"(\d+(?:\.\d+)?)")[0]
    df["engine_size"] = pd.to_numeric(engine_numeric, errors="coerce")
    plt.figure(figsize=(10, 6))
    sns.scatterplot(data=df, x="engine_size", y=price, hue=color)
    plt.title("Car Price vs Engine Size by Color")
    save_show("car_engine_size_price_color.png")
    print("\n11. Price variation by color:")
    print(df.groupby(color)[price].std().sort_values(ascending=False))

    # 12. Seasonal trend
    df["month"] = df["sale_date"].dt.month
    monthly = df.groupby("month").size()
    print("\n12. Monthly sales:")
    print(monthly)
    monthly.plot(kind="line", marker="o")
    plt.title("Monthly Car Sales Trend")
    plt.xlabel("Month")
    plt.ylabel("Number of Sales")
    save_show("car_monthly_sales_trend.png")

    # 13. Body style + transmission
    plt.figure(figsize=(10, 6))
    sns.boxplot(data=df, x=body, y=price, hue=transmission)
    plt.xticks(rotation=45)
    plt.title("Price by Body Style and Transmission")
    save_show("car_body_transmission_price.png")

    # 14. Correlation among price, engine size, income
    corr_cols = ["engine_size", income, price]
    print("\n14. Correlation matrix:")
    print(df[corr_cols].corr())
    sns.heatmap(df[corr_cols].corr(), annot=True, cmap="coolwarm", fmt=".2f")
    plt.title("Car Price, Engine Size and Annual Income Correlation")
    save_show("car_correlation_heatmap.png")

    # 15. Average price by model and engine
    print("\n15. Average price by model and engine:")
    print(df.groupby([model, engine])[price].mean().sort_values(ascending=False).head(30))

    return df


