        amazon_eda()
    else:
        print("\n[SKIP] amazon.csv not found.")

    if SPOTIFY_FILE.exists():
        spotify_eda()
    else:
        print("\n[SKIP] spotify.csv not found.")

    print("\nEDA assignment completed.")


if __name__ == "__main__":
    main()
