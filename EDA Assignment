def amazon_eda():
    print("\n" + "=" * 70)
    print("EDA - AMAZON SALES DATA")
    print("=" * 70)

    df = pd.read_csv(AMAZON_FILE)
    df.columns = [str(c).strip() for c in df.columns]

    category = find_col(df, ["category"])
    product = find_col(df, ["product_name"])
    discounted = find_col(df, ["discounted_price"])
    actual = find_col(df, ["actual_price"])
    discount = find_col(df, ["discount_percentage"])
    rating = find_col(df, ["rating"])
    rating_count = find_col(df, ["rating_count"])
    review_title = find_col(df, ["review_title"])
    review_content = find_col(df, ["review_content"])

    for c in [discounted, actual, discount, rating, rating_count]:
        df[c] = numeric_clean(df[c])

    print("\nShape:", df.shape)
    print("\nMissing values:")
    print(df.isna().sum())

    # 1. Average rating by category
    print("\n1. Average rating by category:")
    print(df.groupby(category)[rating].mean().sort_values(ascending=False))

    # 2. Top rating_count products by category
    top_by_category = (
        df.sort_values(rating_count, ascending=False)
        .groupby(category, as_index=False)
        .head(1)
    )
    print("\n2. Highest rating_count product in each category:")
    print(top_by_category[[category, product, rating_count]].to_string(index=False))

    # 3. Discounted vs actual prices
    plt.figure(figsize=(8, 6))
    sns.scatterplot(data=df, x=actual, y=discounted)
    plt.title("Discounted Price vs Actual Price")
    save_show("amazon_discounted_vs_actual.png")

    # 4. Average discount by category
    print("\n4. Average discount percentage by category:")
    print(df.groupby(category)[discount].mean().sort_values(ascending=False))

    # 5. Most popular product names
    print("\n5. Most popular product names:")
    print(df[product].value_counts().head(10))

    # 6. Most popular product keywords
    stop = {
        "the", "and", "for", "with", "this", "that", "from", "your",
        "you", "are", "has", "have", "best", "more", "than", "only",
        "product", "amazon", "buy", "new", "use", "used"
    }
    words = (
        df[product].dropna().astype(str).str.lower()
        .str.replace(r"[^a-z0-9\s]", " ", regex=True)
        .str.split().explode()
    )
    words = words[~words.isin(stop)]
    print("\n6. Popular product keywords:")
    print(words.value_counts().head(20))

    # 7. Most popular reviews
    print("\n7. Most common review titles:")
    print(df[review_title].value_counts().head(10))

    # 8. Correlation discounted price vs rating
    print("\n8. Correlation between discounted price and rating:",
          df[[discounted, rating]].corr().iloc[0, 1])

    # 9. Top 5 categories by average rating
    print("\n9. Top 5 categories by average rating:")
    print(df.groupby(category)[rating].mean().sort_values(ascending=False).head(5))

    # 10. Potential improvements
    print("\n10. Potential improvement areas:")
    print("- Handle missing prices/ratings before modeling.")
    print("- Standardize price and percentage columns.")
    print("- Investigate products with very high rating counts but low ratings.")
    print("- Analyze review text for sentiment and recurring complaints.")
    print("- Remove duplicate products/reviews where appropriate.")

    return df


