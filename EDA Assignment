# EDA - 4 : SPOTIFY HIP-HOP DATA
# ============================================================

def spotify_eda():
    print("\n" + "=" * 70)
    print("EDA - 4 : SPOTIFY DATA")
    print("=" * 70)

    df = pd.read_csv(SPOTIFY_FILE)
    df.columns = [str(c).strip() for c in df.columns]

    artist = find_col(df, ["Artist"])
    track = find_col(df, ["Track Name"])
    popularity = find_col(df, ["Popularity"])
    duration = find_col(df, ["Duration (ms)"])
    track_id = find_col(df, ["Track ID"])

    df[popularity] = numeric_clean(df[popularity])
    df[duration] = numeric_clean(df[duration])

    # 1. Nulls and duplicates
    print("\n1. Missing values:")
    print(df.isna().sum())
    print("\nDuplicate rows:", df.duplicated().sum())

    df = df.drop_duplicates().copy()
    df = df.dropna(subset=[artist, track, popularity, duration])

    # 2. Popularity distribution
    print("\n2. Popularity statistics:")
    print(df[popularity].describe())
    sns.histplot(df[popularity], bins=20, kde=True)
    plt.title("Distribution of Track Popularity")
    save_show("spotify_popularity_histogram.png")

    # 3. Popularity vs duration
    print("\n3. Correlation popularity vs duration:",
          df[[popularity, duration]].corr().iloc[0, 1])
    sns.scatterplot(data=df, x=duration, y=popularity)
    plt.title("Popularity vs Track Duration")
    save_show("spotify_popularity_vs_duration.png")

    # 4. Artist with highest number of tracks
    artist_counts = df[artist].value_counts()
    print("\n4. Artist with most tracks:", artist_counts.index[0])
    print(artist_counts)
    sns.countplot(data=df, y=artist,
                  order=artist_counts.head(20).index)
    plt.title("Track Count by Artist (Top 20)")
    save_show("spotify_artist_track_counts.png")

    # 5. Top 5 least popular tracks
    print("\n5. Top 5 least popular tracks:")
    print(df.nsmallest(5, popularity)[[artist, track, popularity]].to_string(index=False))

    # 6. Top 5 most popular artists based on average popularity
    artist_avg = df.groupby(artist)[popularity].mean().sort_values(ascending=False)
    top5_artists = artist_avg.head(5)
    print("\n6. Top 5 artists by average popularity:")
    print(top5_artists)

    # 7. Most popular track for each top-5 artist
    print("\n7. Most popular track for each top-5 artist:")
    for a in top5_artists.index:
        row = df[df[artist] == a].nlargest(1, popularity)
        print(a, "->", row[track].iloc[0], "| Popularity:", row[popularity].iloc[0])

    # 8. Pair plot
    pair_cols = [popularity, duration]
    sns.pairplot(df[pair_cols].dropna())
    plt.savefig(OUTPUT / "spotify_pairplot.png", dpi=150, bbox_inches="tight")
    plt.show()
    plt.close()

    # 9. Duration across artists
    selected_artists = df[artist].value_counts().head(10).index
    selected = df[df[artist].isin(selected_artists)]
    plt.figure(figsize=(12, 6))
    sns.boxplot(data=selected, x=artist, y=duration)
    plt.xticks(rotation=45, ha="right")
    plt.title("Track Duration Across Top Artists")
    save_show("spotify_duration_by_artist.png")

    # 10. Popularity distribution across artists
    plt.figure(figsize=(12, 6))
    sns.violinplot(data=selected, x=artist, y=popularity)
    plt.xticks(rotation=45, ha="right")
    plt.title("Popularity Distribution Across Top Artists")
    save_show("spotify_popularity_by_artist.png")

    return df


